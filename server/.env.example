# PostgreSQL (docker-compose defaults)
DATABASE_URL="postgresql://lexa:lexa@localhost:5432/lexa"

# Server
PORT=3000

# Auth
JWT_SECRET="change-me"
# Ставить куки с флагом Secure (только если сайт за HTTPS)
COOKIE_SECURE="0"

# Telegram
TELEGRAM_BOT_TOKEN=""
# Webhook-режим (прод). Пусто — long polling (dev).
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""
# Путь к самоподписанному сертификату (если webhook на IP без домена)
TELEGRAM_WEBHOOK_CERT=""

# AI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Модель для AI-чата (по умолчанию = OPENAI_MODEL)
OPENAI_CHAT_MODEL=""
