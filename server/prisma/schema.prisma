generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum LearningStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum AiStatus {
  PENDING
  READY
  FAILED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

// --- Models ---

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  photoUrl   String?  @map("photo_url")
  createdAt  DateTime @default(now()) @map("created_at")

  // Настройки
  nativeLanguage String @default("ru") @map("native_language") // ISO 639-1, язык переводов
  dailyDueLimit  Int    @default(20) @map("daily_due_limit")
  dailyNewLimit  Int    @default(10) @map("daily_new_limit")

  notebooks       Notebook[]
  vocabularyItems VocabularyItem[]

  @@map("users")
}

model Notebook {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String?
  emoji       String?
  createdAt   DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items NotebookItem[]

  @@index([userId])
  @@map("notebooks")
}

model VocabularyItem {
  id     String @id @default(cuid())
  userId String @map("user_id")
  text   String

  // Заполняется AI-пайплайном
  language     String? // ISO 639-1
  translation  String?
  partOfSpeech String?    @map("part_of_speech")
  explanation  String?
  examples     String[]
  synonyms     String[]
  antonyms     String[]
  level        CefrLevel?
  aiStatus     AiStatus   @default(PENDING) @map("ai_status")
  aiError      String?    @map("ai_error")

  // Статус изучения (для отображения; выводится из FSRS-состояния)
  status LearningStatus @default(NEW)

  // FSRS-состояние карточки (поля Card из ts-fsrs)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Float     @default(0) @map("elapsed_days")
  scheduledDays Float     @default(0) @map("scheduled_days")
  learningSteps Int       @default(0) @map("learning_steps")
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // ts-fsrs State: 0=New 1=Learning 2=Review 3=Relearning
  lastReview    DateTime? @map("last_review")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebooks NotebookItem[]
  reviews   Review[]

  @@unique([userId, text, language])
  @@index([userId, due])
  @@map("vocabulary_items")
}

model NotebookItem {
  notebookId       String   @map("notebook_id")
  vocabularyItemId String   @map("vocabulary_item_id")
  addedAt          DateTime @default(now()) @map("added_at")

  notebook       Notebook       @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  vocabularyItem VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@id([notebookId, vocabularyItemId])
  @@map("notebook_items")
}

model Review {
  id               String       @id @default(cuid())
  vocabularyItemId String       @map("vocabulary_item_id")
  rating           ReviewRating
  reviewedAt       DateTime     @default(now()) @map("reviewed_at")

  // Снапшот FSRS-состояния после этого повторения
  stability  Float
  difficulty Float
  state      Int
  due        DateTime

  vocabularyItem VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@index([vocabularyItemId, reviewedAt])
  @@map("reviews")
}
